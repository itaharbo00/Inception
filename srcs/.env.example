# Copy this file to .env and fill in your own values
# cp srcs/.env.example srcs/.env

# Domain used by WordPress (WP-CLI) during first install
DOMAIN_NAME=example.42.fr

# MariaDB
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=change_me_db_password

# WordPress Admin (avoid using "admin" as username for the 42 subject)
WP_TITLE=Inception
WP_ADMIN_USER=your_admin_login
WP_ADMIN_PASSWORD=change_me_admin_password
WP_ADMIN_EMAIL=your_admin@example.com

# WordPress User (second user)
WP_USER=author
WP_USER_PASSWORD=change_me_user_password
WP_USER_EMAIL=author@example.com

# FTP (bonus)
FTP_USER=ftpuser
FTP_PASSWORD=change_me_ftp_password
